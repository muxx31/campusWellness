# Used by docker-compose.yml (copy to .env). Never commit the real .env.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

GROQ_API_KEY=
COUNSELOR_SIGNUP_MODE=approval

# Only needed for `seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public URL of the site (CORS origin). Change when deploying behind a domain.
PUBLIC_URL=http://localhost:8080
# For HTTPS deployments:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax

# Time zone of your students; booking times are wall-clock times in this zone (IANA name)
SESSION_TZ=Asia/Kolkata
