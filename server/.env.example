# ---- Required ----------------------------------------------------------
NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/campus_wellness
REDIS_URL=redis://127.0.0.1:6379
# >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- HTTP / CORS / cookies --------------------------------------------
# Comma separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (nginx/Render = 1)
TRUST_PROXY=1
# Defaults: production => secure + SameSite=None (cross-site SPA on another domain)
# Same-origin / plain-http setups (docker compose on localhost):
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# ---- Auth --------------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# approval = new counselors must be approved by an admin (recommended) | open
COUNSELOR_SIGNUP_MODE=approval
# Used only by `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Sessions ------------------------------------------------------------
# Booking date/time are wall-clock times in this IANA zone. Sessions last exactly 45 minutes,
# are enforced by the server, and the chat is deleted when they end.
SESSION_TZ=Asia/Kolkata

# ---- Async jobs / AI summaries ----------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
SUMMARY_DELAY_MS=180000
# true = run BullMQ workers inside the API process (single free-tier service)
EMBEDDED_WORKER=false

LOG_LEVEL=info
